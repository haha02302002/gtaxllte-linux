# Extra kernel config for a usable Linux userspace on gtaxllte.
# The stock Android/TWRP kernels disable the virtual terminal, which leaves a
# Linux kernel with no console at all (TWRP paints the framebuffer from
# userspace instead). This fragment turns on VT + fbcon.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_8x16=y
CONFIG_LOGO=y
CONFIG_DEVTMPFS_MOUNT=y
# rdinit=/init: use our initramfs init explicitly.
# panic=0: on panic, halt and leave the message ON SCREEN instead of
# silently rebooting after 5s, so the failure is readable.
CONFIG_CMDLINE="console=tty0 console=ttySAC2,115200 panic=0 rdinit=/init"
CONFIG_CMDLINE_EXTEND=y

# USB peripheral-mode serial console. The tablet has no on-screen keyboard and a
# VT console cannot read the touchscreen, so a shell on tty0 cannot be typed
# into. With the configfs gadget the tablet enumerates on the attached PC as a
# CDC-ACM "USB Serial Device" and the shell runs on /dev/ttyGS0 instead.
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_F_ACM=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y

# The vibrator driver calls microusb/NCM helpers that only exist in Samsung's
# full Android gadget stack (undefined reference to set_ncm_ready and
# microusb_get_usb*_count at vmlinux link time). A serial shell has no use for
# a vibrator, so drop it rather than pull in the whole Android USB stack.
# CONFIG_SEC_VIB is not set

# Samsung's legacy android.c composite probes the only UDC at boot, which would
# leave the configfs gadget below unable to bind and /dev/ttyGS0 missing.
# CONFIG_USB_G_ANDROID is not set

# The FIMC-IS camera stack dumps its resources at ~2.8s into boot and was the
# last thing printed when the kernel stopped before userspace started. Nothing
# here uses a camera, so keep it out of the boot path.
# CONFIG_FIMC_IS_V3_11_0 is not set
# CONFIG_FIMC_BNS_V4_10_0 is not set
