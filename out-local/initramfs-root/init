#!/bin/busybox sh
# Minimal Linux bring-up init for Samsung SM-T585 (gtaxllte).
#
# CRITICAL: this is PID 1. It must NEVER exit, or the kernel panics with
# "Attempted to kill init" and Samsung's watchdog (sec_watchdog.sec_pet=5
# in the bootloader cmdline) reboots the tablet after 5 seconds, forever.
# So: no top-level `exec`, and the shell is respawned in a loop.

/bin/busybox --install -s /bin 2>/dev/null

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root

mount -t proc     proc     /proc  2>/dev/null
mount -t sysfs    sysfs    /sys   2>/dev/null
mount -t devtmpfs devtmpfs /dev   2>/dev/null
mkdir -p /dev/pts /dev/shm /run /tmp /mnt
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs  tmpfs  /run    2>/dev/null
mount -t tmpfs  tmpfs  /tmp    2>/dev/null

# Pick the first console that actually exists.
CONSOLE=/dev/console
for c in /dev/tty0 /dev/tty1 /dev/tty2 /dev/console; do
    if [ -c "$c" ]; then CONSOLE="$c"; break; fi
done

exec >"$CONSOLE" 2>&1

echo
echo "=================================================="
echo "  Linux on SM-T585 (gtaxllte) - initramfs bring-up"
echo "  kernel : $(uname -srm)"
echo "  console: $CONSOLE"
echo "=================================================="
echo
echo "-- kernel command line --"
cat /proc/cmdline
echo
echo "-- registered consoles (tty0 = fbcon) --"
cat /proc/consoles 2>/dev/null
echo
echo "-- framebuffer --"
cat /proc/fb 2>/dev/null || echo "(no /proc/fb)"
ls /dev/fb* /dev/tty* 2>/dev/null | head -20
echo
echo "-- input devices --"
grep -E '^(N|H):' /proc/bus/input/devices 2>/dev/null | head -20
echo

# eMMC userdata partition, if the kernel exposed it.
DATA=
for p in /dev/mmcblk0p23 /dev/block/mmcblk0p23; do
    if [ -b "$p" ]; then DATA="$p"; break; fi
done
if [ -n "$DATA" ]; then
    if mount -t ext4 -o ro "$DATA" /mnt 2>/dev/null; then
        echo "[ok] mounted $DATA (ext4) at /mnt"
    elif mount -t vfat -o ro "$DATA" /mnt 2>/dev/null; then
        echo "[ok] mounted $DATA (vfat) at /mnt"
    else
        echo "[!!] could not mount $DATA"
    fi
else
    echo "[!!] userdata partition not found"
fi
echo

# Respawn the shell forever. If it dies, we log it and come back; PID 1 stays alive.
while true; do
    echo "=== launching shell (type 'help' for busybox applets, 'exit' to respawn) ==="
    if [ -c /dev/tty0 ]; then
        setsid sh -c 'exec sh </dev/tty0 >/dev/tty0 2>&1'
    else
        sh <"$CONSOLE" >"$CONSOLE" 2>&1
    fi
    echo
    echo "=== shell exited; respawning in 3s (init stays alive) ==="
    sleep 3
done
