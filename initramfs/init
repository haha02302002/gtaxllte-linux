#!/bin/busybox sh
# PID 1 for the SM-T585 (gtaxllte) Linux bring-up.
#
# This is a boot *loader*, not an OS: it finds a root filesystem, then
# switch_root()s into it. Order of preference:
#
#   1. root=/dev/... from the kernel command line (also: distro=none for shell)
#   2. microSD card        /dev/mmcblk1p1 (ext4 / f2fs / vfat)
#   3. rootfs.img on userdata (/dev/mmcblk0p23, vfat) via a loop device
#   4. Alpine tree baked into this initramfs (/distro), copied to a tmpfs (RAM)
#   5. fallback: the busybox shell on the USB serial port
#
# The kernel console is deliberately NOT muted while booting: if the kernel
# wedges in a driver, its messages simply stop, which is the only diagnosis
# available when userspace has no way to report. It is muted just before the
# fallback shell, which is when the sm5703 fuelgauge starts flooding.
#
# CRITICAL: this is PID 1. It must NEVER exit, or the kernel panics with
# "Attempted to kill init" and Samsung's watchdog reboots after ~5s.

/bin/busybox --install -s /bin 2>/dev/null

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root
export TERM=linux

echo "[init] starting (PID $$)"
mount -t proc     proc     /proc 2>/dev/null || echo "[init] proc mount failed"
mount -t sysfs    sysfs    /sys  2>/dev/null || echo "[init] sysfs mount failed"
mount -t devtmpfs devtmpfs /dev  2>/dev/null || echo "[init] devtmpfs mount failed"
mkdir -p /dev/pts /dev/shm /run /tmp /media /newroot /sys/kernel/config
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs  tmpfs  /run  2>/dev/null
mount -t tmpfs  tmpfs  /tmp  2>/dev/null

CONSOLE=/dev/console
for c in /dev/tty0 /dev/tty1 /dev/tty2 /dev/console; do
    if [ -c "$c" ]; then CONSOLE="$c"; break; fi
done
exec >"$CONSOLE" 2>&1

NEWROOT=/newroot
ROOT_HOW=""
WANT_ROOT=""
WANT_SHELL=""

echo
echo "=================================================="
echo "  Linux on SM-T585 (gtaxllte) - distro loader"
echo "  kernel: $(uname -srm)"
echo "  console: $CONSOLE"
echo "=================================================="

# ------------------------------------------------------------------ cmdline
for a in $(cat /proc/cmdline); do
    case "$a" in
        root=/dev/*)               WANT_ROOT="${a#root=}" ;;
        distro=none|distro=shell)  WANT_SHELL=1 ;;
    esac
done

# ------------------------------------------------------------------ USB serial
# CDC-ACM gadget over the same cable TWRP uses for adb: gives the shell and the
# distro's getty a typeable console, since tty0 has no input device.
GADGET=/sys/kernel/config/usb_gadget/g1

gadget_make() {
    rm -rf "$GADGET" 2>/dev/null
    mkdir -p "$GADGET" || return 1
    echo 0x1d6b > "$GADGET/idVendor"
    echo 0x0104 > "$GADGET/idProduct"
    echo 0x0100 > "$GADGET/bcdDevice"
    echo 0x0200 > "$GADGET/bcdUSB"
    mkdir -p "$GADGET/strings/0x409"
    echo "gtaxllte-linux"             > "$GADGET/strings/0x409/manufacturer"
    echo "SM-T585 USB serial console" > "$GADGET/strings/0x409/product"
    echo "0001"                      > "$GADGET/strings/0x409/serialnumber"
    mkdir -p "$GADGET/configs/c.1/strings/0x409"
    echo "ACM" > "$GADGET/configs/c.1/strings/0x409/configuration"
    echo 100   > "$GADGET/configs/c.1/MaxPower"
    return 0
}

usb_serial_setup() {
    mount -t configfs none /sys/kernel/config 2>/dev/null
    [ -d /sys/kernel/config/usb_gadget ] || return 1
    gadget_make || return 1
    if mkdir -p "$GADGET/functions/acm.gs0" 2>/dev/null && [ -d "$GADGET/functions/acm.gs0" ]; then
        FUNC="$GADGET/functions/acm.gs0"
    elif mkdir -p "$GADGET/functions/gser.gs0" 2>/dev/null && [ -d "$GADGET/functions/gser.gs0" ]; then
        FUNC="$GADGET/functions/gser.gs0"
    else
        return 1
    fi
    ln -s "$FUNC" "$GADGET/configs/c.1/" 2>/dev/null
    UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
    [ -n "$UDC" ] || return 1
    echo "$UDC" > "$GADGET/UDC" 2>/dev/null || return 1
    return 0
}

echo "[init] setting up USB serial gadget"
if usb_serial_setup; then
    i=0
    while [ $i -lt 20 ]; do
        [ -c /dev/ttyGS0 ] && break
        sleep 0.5 2>/dev/null || sleep 1
        i=$((i + 1))
    done
    echo "[init] USB serial: $( [ -c /dev/ttyGS0 ] && echo '/dev/ttyGS0 ready' || echo 'gadget bound, no ttyGS0' )"
else
    echo "[init] USB serial gadget FAILED"
fi

# ------------------------------------------------------------------ rootfs helpers
# Accept a candidate only if it looks like a real root filesystem, otherwise a
# random data card would be mounted and switch_root would fail.
accept_root() {
    if [ -e "$NEWROOT/sbin/init" ] || [ -L "$NEWROOT/sbin/init" ] || [ -f "$NEWROOT/etc/os-release" ]; then
        return 0
    fi
    echo "[..]   not a root filesystem, unmounting"
    umount "$NEWROOT" 2>/dev/null
    return 1
}

try_root_dev() {
    for fs in ext4 f2fs vfat; do
        if mount -t "$fs" -o rw "$1" "$NEWROOT" 2>/dev/null; then
            echo "[..]   mounted $1 as $fs"
            return 0
        fi
    done
    return 1
}

mount_data() {
    for fs in vfat ext4; do
        if mount -t "$fs" -o ro /dev/mmcblk0p23 /media 2>/dev/null; then
            return 0
        fi
    done
    return 1
}

loop_try() {
    img="$1"
    if losetup /dev/loop0 "$img" 2>/dev/null; then
        if try_root_dev /dev/loop0; then return 0; fi
        losetup -d /dev/loop0 2>/dev/null
        return 1
    fi
    # busybox mount can attach the loop device by itself
    if mount -t ext4 -o loop,rw "$img" "$NEWROOT" 2>/dev/null; then
        echo "[..]   mounted via mount -o loop"
        return 0
    fi
    return 1
}

find_rootfs() {
    echo "[1/4] cmdline root="
    if [ -n "$WANT_ROOT" ]; then
        if try_root_dev "$WANT_ROOT" && accept_root; then
            ROOT_HOW="cmdline $WANT_ROOT"; return 0
        fi
    else
        echo "[..]   none given"
    fi

    echo "[2/4] microSD"
    for d in /dev/mmcblk1p1 /dev/mmcblk1p2; do
        if [ -b "$d" ]; then
            echo "[..]   trying $d"
            if try_root_dev "$d" && accept_root; then
                ROOT_HOW="$d (microSD)"; return 0
            fi
        fi
    done
    echo "[..]   no usable card"

    echo "[3/4] rootfs.img on userdata"
    if mount_data; then
        for img in /media/rootfs.img /media/media/0/rootfs.img /media/linux/rootfs.img /media/rootfs/rootfs.img /media/0/rootfs.img; do
            if [ -f "$img" ]; then
                echo "[..]   found $img"
                if loop_try "$img" && accept_root; then
                    ROOT_HOW="$img (loop)"; return 0
                fi
            fi
        done
        echo "[..]   no rootfs.img"
    else
        echo "[..]   could not mount userdata"
    fi

    echo "[4/4] embedded Alpine (/distro -> RAM)"
    if [ -d /distro ]; then
        if mount -t tmpfs -o size=400M,mode=0755 tmpfs "$NEWROOT" 2>/dev/null; then
            echo "[..]   copying rootfs into tmpfs"
            if cp -a /distro/. "$NEWROOT/" 2>/dev/null; then
                # The distro needs a getty on the USB gadget port, otherwise it
                # boots with no way to log in.
                if [ -f "$NEWROOT/etc/inittab" ] && ! grep -q ttyGS0 "$NEWROOT/etc/inittab"; then
                    echo 'ttyGS0::respawn:/sbin/getty -L ttyGS0 115200 vt100' \
                        >> "$NEWROOT/etc/inittab"
                fi
                ROOT_HOW="embedded Alpine (RAM only)"; return 0
            fi
            echo "[!!]   copy failed"
            umount "$NEWROOT" 2>/dev/null
        fi
    else
        echo "[..]   no embedded distro"
    fi
    return 1
}

switch_to_root() {
    echo "[init] moving dev/proc/sys into $NEWROOT"
    for d in dev proc sys; do
        mkdir -p "$NEWROOT/$d"
        mount -o move "/$d" "$NEWROOT/$d" 2>/dev/null || echo "[!!]   could not move /$d"
    done
    echo "[init] switching to $ROOT_HOW"
    echo "=================================================="
    exec switch_root "$NEWROOT" /sbin/init
}

# ------------------------------------------------------------------ boot
if [ -z "$WANT_SHELL" ] && find_rootfs; then
    switch_to_root
    echo "[!!] switch_root failed"
fi

if [ -n "$WANT_SHELL" ]; then
    echo "[init] distro=none -> shell only"
else
    echo "[init] no root filesystem found -> shell"
fi

# From here on the console is quiet except for crit/emerg; the sm5703 fuelgauge
# has no charger power-supply partner in a bare userspace and retries forever.
dmesg -n 2 2>/dev/null

# ------------------------------------------------------------ serial shell
# Background first: the tty0 loop below blocks on input that cannot arrive.
if [ -c /dev/ttyGS0 ]; then
    (
        while true; do
            # setsid -c makes this a session leader owning ttyGS0, which is what
            # gives working job control; stdin is ttyGS0 so TIOCSCTTY targets it.
            TERM=vt100 setsid -c sh -c 'exec sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1' \
                </dev/ttyGS0 >/dev/ttyGS0 2>&1
            sleep 1
        done
    ) &
    echo "=== shell running on ttyGS0 (USB serial) ==="
fi

# ------------------------------------------------------------ VT shell
while true; do
    if [ -c /dev/tty0 ]; then
        setsid -c sh -c 'exec sh -i </dev/tty0 >/dev/tty0 2>&1' </dev/tty0 >/dev/tty0 2>&1
        sleep 3
    else
        sleep 10
    fi
done
